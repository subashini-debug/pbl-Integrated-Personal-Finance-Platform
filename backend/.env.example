# Optional server-wide default Grok key. Leave blank to require users to
# paste their own key in the Settings page instead. Never commit a real
# key here -- this file is a template, .env itself is git-ignored.
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-fast
DATABASE_URL=sqlite:///./fintrack.db
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Secret used to sign login sessions (JWTs). Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left blank, a random key is generated at process startup, which works
# fine for a demo but means everyone is logged out on every server restart.
# Never commit a real value here -- this file is a template, .env is git-ignored.
JWT_SECRET_KEY=
